          "judgments": {
            "title": "Judgments",
            "type": "integer"
          }
        },
        "required": [
          "court_code",
          "court_name",
          "judgments"
        ],
        "title": "CourtInfo",
        "type": "object"
      },
      "CourtsResponse": {
        "properties": {
          "courts": {
            "items": {
              "$ref": "#/components/schemas/CourtInfo"
