{
  "components": {
    "schemas": {
      "CaseResult": {
        "description": "One case; ``judgments`` lists every URI publishing the same text.",
        "properties": {
          "also_published_as": {
            "items": {
              "$ref": "#/components/schemas/JudgmentRef"
            },
            "title": "Also Published As",
            "type": "array"
          },
          "judgment": {
            "$ref": "#/components/schemas/JudgmentRef"
          },
          "match_type": {
            "enum": [
              "citation",
              "case_name",
              "lexical",
              "dense",
              "hybrid"
            ],
            "title": "Match Type",
            "type": "string"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/PassageResult"
            },
            "title": "Passages",
            "type": "array"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "judgment",
          "also_published_as",
          "match_type",
          "score",
          "passages"
        ],
        "title": "CaseResult",
        "type": "object"
      },
      "ChatClaim": {
        "properties": {
          "kind": {
            "enum": [
              "holding",
              "obiter",
              "fact",
              "inference"
            ],
            "title": "Kind",
            "type": "string"
          },
          "pinpoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Verified PDF page(s) of the passage holding the quote (1-based), else null",
            "title": "Pinpoint"
          },
          "quote": {
            "description": "Verbatim from the passage quote_chunk_id (checked)",
            "title": "Quote",
            "type": "string"
          },
          "quote_chunk_id": {
            "format": "uuid",
            "title": "Quote Chunk Id",
            "type": "string"
          },
          "source_numbers": {
            "items": {
              "type": "integer"
            },
            "title": "Source Numbers",
            "type": "array"
          },
          "support_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Probability that a cited passage entails the claim (NLI model)",
            "title": "Support Score"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "kind",
          "source_numbers",
          "quote",
          "quote_chunk_id",
          "pinpoint",
          "support_score"
        ],
        "title": "ChatClaim",
        "type": "object"
      },
      "ChatPassage": {
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page End"
          },
          "page_reference_status": {
            "enum": [
              "verified",
              "unknown",
              "pending"
            ],
            "title": "Page Reference Status",
            "type": "string"
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0-based PDF page; only when verified",
            "title": "Page Start"
          }
        },
        "required": [
          "chunk_id",
          "excerpt",
          "page_reference_status",
          "page_start",
          "page_end"
        ],
        "title": "ChatPassage",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "question": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "abstain_reason": {
            "anyOf": [
              {
                "enum": [
                  "no_results",
                  "model_abstained",
                  "no_supported_claims",
                  "invalid_model_output"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstain Reason"
          },
          "abstained": {
            "title": "Abstained",
            "type": "boolean"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Built from verified claims only; [n] = sources[n]",
            "title": "Answer"
          },
          "attribution": {
            "default": "Source: Ghana Legal Information Institute (GhaLII, ghalii.org), licensed CC BY-NC 4.0. Non-commercial use with attribution.",
            "title": "Attribution",
            "type": "string"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ChatClaim"
            },
            "title": "Claims",
            "type": "array"
          },
          "generation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerationInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "matched_cases": {
            "items": {
              "$ref": "#/components/schemas/JudgmentRef"
            },
            "title": "Matched Cases",
            "type": "array"
          },
          "model_limitations": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Limitations"
          },
          "notice": {
            "default": "Assisted legal research, not legal advice. Corpus coverage may be incomplete; absence of a result does not mean absence in Ghanaian law.",
            "title": "Notice",
            "type": "string"
          },
          "query_info": {
            "$ref": "#/components/schemas/QueryInfo"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSource"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "question",
          "session_id",
          "abstained",
          "abstain_reason",
          "answer",
          "claims",
          "sources",
          "limitations",
          "model_limitations",
          "matched_cases",
          "query_info",
          "generation"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "ChatSource": {
        "description": "A judgment cited by the answer; ``number`` is its marker in the answer text.",
        "properties": {
          "also_published_as": {
            "items": {
              "$ref": "#/components/schemas/JudgmentRef"
            },
            "title": "Also Published As",
            "type": "array"
          },
          "judgment": {
            "$ref": "#/components/schemas/JudgmentRef"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/ChatPassage"
            },
            "title": "Passages",
            "type": "array"
          }
        },
        "required": [
          "number",
          "judgment",
          "also_published_as",
          "passages"
        ],
        "title": "ChatSource",
        "type": "object"
      },
      "ContextPassage": {
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
