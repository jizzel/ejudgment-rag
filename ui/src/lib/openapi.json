        "title": "QueryInfo",
        "type": "object"
      },
      "SearchFilters": {
        "additionalProperties": false,
        "description": "Strict filters: applied exactly, never widened.",
        "properties": {
          "court": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9-]{2,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AKN court code",
            "title": "Court"
          },
          "judge": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge"
          },
          "jurisdiction": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9-]{2,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AKN code",
            "title": "Jurisdiction"
          },
          "year_from": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1900.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year From"
          },
          "year_to": {
            "anyOf": [
              {
                "maximum": 2100.0,
                "minimum": 1900.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year To"
          }
        },
        "title": "SearchFilters",
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "mode": {
            "default": "hybrid",
            "enum": [
              "hybrid",
              "lexical",
              "dense"
            ],
            "title": "Mode",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "query": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "rerank": {
            "default": true,
            "title": "Rerank",
            "type": "boolean"
          },
          "top_k": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "attribution": {
            "default": "Source: Ghana Legal Information Institute (GhaLII, ghalii.org), licensed CC BY-NC 4.0. Non-commercial use with attribution.",
            "title": "Attribution",
            "type": "string"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/CaseResult"
            },
            "title": "Cases",
            "type": "array"
          },
          "notice": {
            "default": "Assisted legal research, not legal advice. Corpus coverage may be incomplete; absence of a result does not mean absence in Ghanaian law.",
            "title": "Notice",
            "type": "string"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/PassageResult"
            },
            "title": "Passages",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "query_info": {
            "$ref": "#/components/schemas/QueryInfo"
          }
        },
        "required": [
          "query",
          "passages",
          "cases",
          "query_info"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SourceInfo": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime Type"
          },
          "original_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Url"
          },
          "rights_status": {
            "title": "Rights Status",
            "type": "string"
          },
          "verification_status": {
            "title": "Verification Status",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "mime_type",
          "verification_status",
          "rights_status",
          "original_url"
        ],
        "title": "SourceInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Source-grounded search and answers over Ghanaian judgments from GhaLII (CC BY-NC 4.0). Assisted legal research, not legal advice.",
    "title": "E-Judgment legal research API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/chat": {
      "post": {
        "description": "Answer from retrieved passages only; abstains (with matched cases) when it cannot.",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Chat"
      }
    },
    "/v1/courts": {
      "get": {
        "description": "Courts with eligible judgments (for search filters).",
        "operationId": "read_courts_v1_courts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourtsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Courts"
      }
    },
    "/v1/judgments/{judgment_id}": {
      "get": {
        "operationId": "read_judgment_v1_judgments__judgment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "judgment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Judgment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JudgmentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Judgment"
      }
    },
    "/v1/passages/{chunk_id}": {
      "get": {
        "description": "A passage of an eligible judgment with its neighbours, for reading in context.",
        "operationId": "read_passage_v1_passages__chunk_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "chunk_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Chunk Id",
              "type": "string"
            }
          },
          {
            "description": "Neighbouring passages per side",
            "in": "query",
            "name": "context",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Neighbouring passages per side",
              "maximum": 3,
              "minimum": 0,
              "title": "Context",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PassageContext"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Passage"
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search_judgments_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Search Judgments"
      }
    }
  }
}
