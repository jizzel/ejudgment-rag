            "title": "Chunk Count",
            "type": "integer"
          },
          "judges": {
            "items": {
              "type": "string"
            },
            "title": "Judges",
            "type": "array"
          },
          "judgment": {
            "$ref": "#/components/schemas/JudgmentRef"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
