          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "0-based PDF page; only when verified",
            "title": "Page Start"
          },
          "section_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Label"
          }
        },
        "required": [
          "chunk_id",
          "ordinal",
          "excerpt",
          "section_label",
          "page_reference_status",
          "page_start",
          "page_end"
        ],
        "title": "ContextPassage",
        "type": "object"
      },
      "CourtInfo": {
        "properties": {
          "court_code": {
            "title": "Court Code",
            "type": "string"
          },
          "court_name": {
            "anyOf": [
              {
