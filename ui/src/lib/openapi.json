            "type": "array"
          }
        },
        "required": [
          "courts"
        ],
        "title": "CourtsResponse",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GenerationInfo": {
        "properties": {
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "invalid_source_ids": {
            "title": "Invalid Source Ids",
            "type": "integer"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "description": "The model the provider reports having run",
            "title": "Model",
            "type": "string"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "removed_claims": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Claims dropped by verification, by reason",
            "title": "Removed Claims",
            "type": "object"
          },
          "requested_model": {
            "description": "The configured model name (may be an alias)",
            "title": "Requested Model",
            "type": "string"
          },
          "source_ids_cited": {
            "title": "Source Ids Cited",
            "type": "integer"
          },
          "sources_sent": {
            "title": "Sources Sent",
            "type": "integer"
          },
          "support_model": {
            "description": "NLI model@revision that checked the claims",
            "title": "Support Model",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "requested_model",
          "prompt_version",
          "support_model",
          "input_tokens",
          "output_tokens",
          "latency_ms",
          "sources_sent",
          "source_ids_cited",
          "invalid_source_ids",
          "removed_claims"
