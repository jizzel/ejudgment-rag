          "canonical_uri",
          "citation",
          "title",
          "court_code",
          "court_name",
          "jurisdiction",
          "judgment_date",
          "source_url"
        ],
        "title": "JudgmentRef",
        "type": "object"
      },
      "PassageContext": {
        "description": "A passage with the passages around it in the same judgment, for reading in context.",
        "properties": {
          "after": {
            "items": {
              "$ref": "#/components/schemas/ContextPassage"
            },
            "title": "After",
            "type": "array"
          },
          "attribution": {
            "default": "Source: Ghana Legal Information Institute (GhaLII, ghalii.org), licensed CC BY-NC 4.0. Non-commercial use with attribution.",
            "title": "Attribution",
