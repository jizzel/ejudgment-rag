          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "judgment": {
            "$ref": "#/components/schemas/JudgmentRef"
          },
          "lexical_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lexical Score"
          },
          "match_type": {
            "enum": [
              "citation",
