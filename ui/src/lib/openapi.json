      "QueryInfo": {
        "properties": {
          "degraded": {
            "default": false,
            "title": "Degraded",
            "type": "boolean"
          },
          "degraded_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
