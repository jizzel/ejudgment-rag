          "notice": {
            "default": "Assisted legal research, not legal advice. Corpus coverage may be incomplete; absence of a result does not mean absence in Ghanaian law.",
            "title": "Notice",
            "type": "string"
          },
          "source_status": {
            "title": "Source Status",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceInfo"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "judgment",
          "case_number",
          "language",
          "judges",
          "neutral_citation",
          "source_status",
          "sources",
          "chunk_count"
        ],
        "title": "JudgmentDetail",
        "type": "object"
      },
      "JudgmentRef": {
        "properties": {
