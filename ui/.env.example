# Copy to ui/.env.local (gitignored). Read by the Next.js server only, never sent to browsers.

# Where the FastAPI service runs (server-side calls only).
EJUDGMENT_API_URL=http://127.0.0.1:8000

# Session cookies are Secure (HTTPS only) unless this is 1. Set it only for plain-http local
# use on 127.0.0.1; never behind a public address.
# UI_INSECURE_COOKIES=1
