# The only published service. SITE_ADDRESS ":80" serves plain http (local use, with
# UI_INSECURE_COOKIES=1); a domain name (e.g. research.example.org) gets automatic HTTPS.
{
	admin off
	# Proxies in front of Caddy whose X-Forwarded-* headers are kept (the UI's same-origin
	# check compares Origin with X-Forwarded-Proto/-Host). The default trusts nothing that can
	# connect, so Caddy sets them itself. Behind Cloudflare Tunnel (TLS ends at Cloudflare,
	# cloudflared connects over plain http) set TRUSTED_PROXIES=private_ranges in .env, or every
	# question is refused as cross-origin. Never with Caddy published to the internet.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$SITE_ADDRESS}

header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	# Same-origin only. Next's pages carry inline scripts and style attributes, so a nonce-free
	# policy needs 'unsafe-inline' there; it still blocks scripts, styles, images, connections
	# and form posts to other sites, plugins and <base> rewrites. (A nonce policy would stop
	# the UI's prerendering.) Corpus text is rendered only as text.
	# The one outside origin: Cloudflare Web Analytics (cookie-free), which Cloudflare injects
	# behind the tunnel; its script comes from static.cloudflareinsights.com and reports to
	# cloudflareinsights.com. Unused, and harmless, everywhere else.
	Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

@https protocol https
header @https Strict-Transport-Security "max-age=31536000"

# Caddy sets X-Forwarded-For/-Proto/-Host, which the UI's same-origin check relies on.
# The answer stream (server-sent events) is kept out of `encode`, which compressed and held
# back small events when the UI sent no `Cache-Control: no-transform`. reverse_proxy flushes
# text/event-stream immediately on its own, and a client that goes away closes the upstream,
# even while the stream is silent, so Cancel reaches the API and the model.
# scripts/check_proxy_stream.sh checks all of this.
@answer_stream path /api/chat
handle @answer_stream {
	reverse_proxy ui:3000
}

handle {
	encode zstd gzip
	reverse_proxy ui:3000
}
