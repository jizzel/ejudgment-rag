# The only published service. SITE_ADDRESS ":80" serves plain http (local use, with
# UI_INSECURE_COOKIES=1); a domain name (e.g. research.example.org) gets automatic HTTPS.
{
	admin off
}

{$SITE_ADDRESS}

header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	Content-Security-Policy "frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

@https protocol https
header @https Strict-Transport-Security "max-age=31536000"

# Caddy sets X-Forwarded-For/-Proto/-Host, which the UI's same-origin check relies on.
# The answer stream (server-sent events) is kept out of `encode`, which compressed and held
# back small events when the UI sent no `Cache-Control: no-transform`. reverse_proxy flushes
# text/event-stream immediately on its own, and a client that goes away closes the upstream,
# even while the stream is silent, so Cancel reaches the API and the model.
# scripts/check_proxy_stream.sh checks all of this.
@answer_stream path /api/chat
handle @answer_stream {
	reverse_proxy ui:3000
}

handle {
	encode zstd gzip
	reverse_proxy ui:3000
}
