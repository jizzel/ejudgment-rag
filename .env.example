# Copy to .env (gitignored) and adjust. Precedence: environment variables > .env >
# config/models.yaml > code defaults (src/ejudgment/config.py). Never commit .env.
# Non-secret tuning (models, chunking, retrieval, generation limits, prices) lives in
# config/models.yaml; set a variable here only to override it on this machine.

# --- Database -------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ejudgment:ejudgment@localhost:5434/ejudgment
# Host port of the Compose Postgres (read by docker-compose.yml, not by the app).
# EJUDGMENT_DB_PORT=5434

# --- Sign-in and audit (M4) -----------------------------------------------------------------
# Secret for the keyed hashes of emails and client addresses in auth_events. Set it to a long
# random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`); without
# it a per-process salt is used and the login lockout resets whenever the API restarts.
AUTH_HASH_SECRET=change-me-to-a-long-random-value
# Every /v1 route requires a signed-in session. Never set false outside tests.
# AUTH_REQUIRED=true
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15
# Store raw query text in query_audit (default: hashes only). Needs a retention policy first.
# AUDIT_STORE_RAW_QUERIES=false
# Retention in days (worker.retention).
# AUDIT_RETENTION_DAYS=90
# AUTH_EVENT_RETENTION_DAYS=365
# SESSION_RETENTION_DAYS=7
# USAGE_RETENTION_DAYS=730

# --- Answer generation ----------------------------------------------------------------------
# ollama (default, local: questions stay on this machine) or openai (opt-in, paid).
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=gemma4:latest

# OpenAI: opt-in. Needs OPENAI_ENABLED=true, LLM_PROVIDER=openai (or --provider openai) and a
# model priced in config/models.yaml (openai_prices). User questions are then sent to OpenAI.
# OPENAI_ENABLED=false
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-6-luna
# Per-run soft stop (an evaluation run, or one UTC day of /v1/chat); also set a project
# budget in the OpenAI dashboard.
# OPENAI_TEST_BUDGET_USD=1.00
# OPENAI_MAX_CALLS_PER_RUN=20

# --- Models ---------------------------------------------------------------------------------
# Weights load from the Hugging Face cache only (fetch them once with worker.models
# fetch-models). Set to be sure nothing is downloaded at run time.
# HF_HUB_OFFLINE=1
# MODEL_DEVICE=auto
